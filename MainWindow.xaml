<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="SptConfigStudio.MainWindow"
        Title="SPT 配置中心" Height="820" Width="1320"
        MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Brasa.Background}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- brand + primary actions -->
        <Grid Grid.Row="0" Background="{DynamicResource Brasa.Surface}" Height="54">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                <Border Width="26" Height="26" CornerRadius="4" Background="{DynamicResource Brasa.Accent}">
                    <TextBlock Text="S" FontSize="15" FontWeight="Bold" Foreground="#FF141412"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="SPT 配置中心" FontSize="14" FontWeight="SemiBold" />
                    <TextBlock Text="EFT 5.0 · SPT 5 服务端" FontSize="10.5" Foreground="{DynamicResource Brasa.TextDim}" />
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0">
                <Button x:Name="BtnSave" Style="{StaticResource Brasa.Button.Primary}" Content="保存修改"
                        Click="OnSave" Padding="16,6" />
                <Button x:Name="BtnRevert" Content="放弃修改" Click="OnRevert" Margin="8,0,0,0" />
                <Border Width="1" Height="22" Background="{DynamicResource Brasa.Border}" Margin="12,0" />
                <Button x:Name="BtnBackupNow" Content="立即备份" Click="OnBackupNow" ToolTip="先把当前配置打包成 zip，再继续后续修改" />
                <Button x:Name="BtnRestore" Content="还原备份…" Click="OnRestore" Margin="8,0,0,0" />
                <Border Width="1" Height="22" Background="{DynamicResource Brasa.Border}" Margin="12,0" />
                <TextBox x:Name="Search" Width="230" Height="28" VerticalContentAlignment="Center"
                         TextChanged="OnSearchChanged" ToolTip="在所有配置项中搜索：字段名、路径或当前值" />
                <TextBlock x:Name="SearchPlaceholder" Text="搜索配置项…" Foreground="{DynamicResource Brasa.TextDim}"
                           Margin="-232,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left"
                           Padding="8,0" IsHitTestVisible="False" FontSize="12.5" />
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                <Ellipse x:Name="ServerDot" Width="9" Height="9" Fill="{DynamicResource Brasa.TextDim}" VerticalAlignment="Center" />
                <TextBlock x:Name="ServerText" Text="检测中…" Margin="7,0,12,0" FontSize="12"
                           Foreground="{DynamicResource Brasa.TextDim}" VerticalAlignment="Center" />
                <Button Content="打开面板" Click="OnOpenPanel" FontSize="12" Padding="10,5" />
                <Button Content="目录" Click="OnOpenFolder" FontSize="12" Padding="10,5" Margin="6,0,0,0" />
            </StackPanel>
        </Grid>

        <!-- warning strip: shown while the server is running -->
        <Border x:Name="WarnStrip" Grid.Row="1" Background="#FF3A2C12" BorderBrush="{DynamicResource Brasa.Warn}"
                BorderThickness="0,1,0,1" Padding="16,7" Visibility="Collapsed">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="!" Width="17" Height="17" TextAlignment="Center" FontWeight="Bold"
                           Foreground="#FF141412" Background="{DynamicResource Brasa.Warn}" VerticalAlignment="Center" />
                <TextBlock x:Name="WarnText" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="12.5"
                           Foreground="#FFE8DCC0"
                           Text="服务端正在运行：写入磁盘不会影响当前进程，需要重启服务端后新配置才会生效。" />
            </StackPanel>
        </Border>

        <!-- sidebar + content -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{DynamicResource Brasa.Surface}" BorderBrush="{DynamicResource Brasa.Border}"
                    BorderThickness="0,1,1,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,8">
                    <StackPanel x:Name="Nav" />
                </ScrollViewer>
            </Border>

            <Border Grid.Column="1" Background="{DynamicResource Brasa.Background}">
                <ContentControl x:Name="Host" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
            </Border>
        </Grid>

        <!-- status bar -->
        <Border Grid.Row="3" Background="{DynamicResource Brasa.Surface}" BorderBrush="{DynamicResource Brasa.Border}"
                BorderThickness="0,1,0,0" Height="28">
                <Grid Margin="16,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="StatusLeft" Grid.Column="0" FontSize="11.5" FontFamily="{DynamicResource Brasa.Mono}"
                               Foreground="{DynamicResource Brasa.TextDim}" VerticalAlignment="Center" Text="就绪" />
                    <TextBlock x:Name="StatusRight" Grid.Column="1" FontSize="11.5"
                               Foreground="{DynamicResource Brasa.TextDim}" VerticalAlignment="Center" />
                </Grid>
            </Border>

        <!-- floating search results -->
        <Border x:Name="SearchOverlay" Grid.RowSpan="4" Panel.ZIndex="100" Visibility="Collapsed"
                HorizontalAlignment="Left" VerticalAlignment="Top" Margin="242,58,0,0" Width="520"
                Background="{DynamicResource Brasa.Surface}" BorderBrush="{DynamicResource Brasa.BorderHi}"
                BorderThickness="1" CornerRadius="4">
            <StackPanel>
                <TextBlock x:Name="SearchSummary" Margin="12,9,12,6" FontSize="11.5"
                           Foreground="{DynamicResource Brasa.TextDim}" Text="搜索结果" />
                <ScrollViewer MaxHeight="420" VerticalScrollBarVisibility="Auto" Padding="6,0,8,8">
                    <StackPanel x:Name="SearchResults" />
                </ScrollViewer>
            </StackPanel>
        </Border>
    </Grid>
</Window>
