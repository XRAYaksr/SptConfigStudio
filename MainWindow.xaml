<ui:FluentWindow xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        x:Class="SptConfigStudio.MainWindow"
        Title="SPT 配置中心" Height="820" Width="1320"
        MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        Foreground="{DynamicResource Brasa.Text}"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        WindowCornerPreference="Round"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">

    <!-- FluentWindow paints its client area with TemplateBinding Background, and the library default is an
         opaque #FF202020, so the root has to stay Transparent or the Mica backdrop is never visible. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="SPT 配置中心" FontWeight="SemiBold" ShowHelp="False">
            <ui:TitleBar.Icon>
                <ui:SymbolIcon Symbol="Server24" FontSize="15" Foreground="{DynamicResource Brasa.Accent}" />
            </ui:TitleBar.Icon>
            <ui:TitleBar.TrailingContent>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                    <Ellipse x:Name="ServerDot" Width="9" Height="9" Fill="{DynamicResource Brasa.TextDim}" VerticalAlignment="Center" />
                    <TextBlock x:Name="ServerText" Text="检测中…" Margin="7,0,14,0" FontSize="12"
                               Foreground="{DynamicResource Brasa.TextDim}" VerticalAlignment="Center" />
                    <ui:Button Content="打开面板" Click="OnOpenPanel" FontSize="12" Padding="10,4" Appearance="Transparent" />
                    <ui:Button Content="目录" Click="OnOpenFolder" FontSize="12" Padding="10,4" Margin="4,0,0,0" Appearance="Transparent" />
                </StackPanel>
            </ui:TitleBar.TrailingContent>
        </ui:TitleBar>

        <!-- command bar: the primary actions stay out of the title bar, which is a drag surface -->
        <Border Grid.Row="1" Background="{DynamicResource Brasa.Layer}" BorderBrush="{DynamicResource Brasa.Sep}"
                BorderThickness="0,0,0,1" Height="46">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0">
                <ui:Button x:Name="BtnSave" Style="{DynamicResource Brasa.Button.Primary}" Content="保存修改"
                           Click="OnSave" Padding="14,5" />
                <Button x:Name="BtnRevert" Content="放弃修改" Click="OnRevert" Margin="8,0,0,0" />
                <Border Width="1" Height="22" Background="{DynamicResource Brasa.Border}" Margin="12,0" />
                <Button x:Name="BtnBackupNow" Content="立即备份" Click="OnBackupNow" ToolTip="先把当前配置打包成 zip，再继续后续修改" />
                <Button x:Name="BtnRestore" Content="还原备份…" Click="OnRestore" Margin="8,0,0,0" />
                <Border Width="1" Height="22" Background="{DynamicResource Brasa.Border}" Margin="12,0" />
                <ui:TextBox x:Name="Search" Width="240" VerticalContentAlignment="Center"
                            PlaceholderText="搜索配置项…" TextChanged="OnSearchChanged"
                            ToolTip="在所有配置项中搜索：字段名、路径或当前值" />
            </StackPanel>
        </Border>

        <ui:InfoBar x:Name="WarnStrip" Grid.Row="2" Margin="16,6,16,0" Severity="Warning" IsClosable="False" IsOpen="False" />

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- the pane is 232 plus the template's own 4px on each side; compact is 40 plus the same 8px.
                 Clipping matters beyond tidiness: the library's PART_ScrollViewer carries Margin="0,0,-4,0", so the
                 pane really paints ~4px past this border's right edge, today hidden only because the editor cell is
                 drawn over it. Mid-collapse the shell leads the pane and that overflow becomes a live leak. -->
            <Border Grid.Column="0" x:Name="PaneShell" Width="240" ClipToBounds="True"
                    Background="{DynamicResource Brasa.PaneBackground}" BorderBrush="{DynamicResource Brasa.Sep}"
                    BorderThickness="0,0,1,0">
                <Grid x:Name="PaneLayer">
                    <ui:NavigationView x:Name="Nav" PaneDisplayMode="LeftMinimal" OpenPaneLength="232"
                                       CompactPaneLength="40" IsPaneToggleVisible="True" IsBackButtonVisible="Collapsed"
                                       HeaderVisibility="Collapsed" IsTopSeparatorVisible="False"
                                       KeyboardNavigation.TabNavigation="Local" />

                    <!-- the selection bar NavPane slides between rows; the library's own is forced Transparent -->
                    <Rectangle x:Name="NavCursor" Width="3" Height="16" RadiusX="2" RadiusY="2" Opacity="0"
                               HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False"
                               Fill="{DynamicResource Brasa.Accent}">
                        <Rectangle.RenderTransform>
                            <TranslateTransform x:Name="NavCursorMove" />
                        </Rectangle.RenderTransform>
                    </Rectangle>
                </Grid>
            </Border>

            <Border Grid.Column="1" Background="{DynamicResource Brasa.ContentBackground}">
                <ContentControl x:Name="Host" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
            </Border>

            <!-- floating search results -->
            <Border x:Name="SearchOverlay" Grid.Column="1" Panel.ZIndex="100" Visibility="Collapsed"
                    HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8,8,0,0" Width="520"
                    Background="{DynamicResource Brasa.Surface}" BorderBrush="{DynamicResource Brasa.BorderHi}"
                    BorderThickness="1" CornerRadius="8">
                <StackPanel>
                    <TextBlock x:Name="SearchSummary" Margin="12,9,12,6" FontSize="11.5"
                               Foreground="{DynamicResource Brasa.TextDim}" Text="搜索结果" />
                    <ScrollViewer MaxHeight="420" VerticalScrollBarVisibility="Auto" Padding="6,0,8,8">
                        <StackPanel x:Name="SearchResults" />
                    </ScrollViewer>
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="4" Background="{DynamicResource Brasa.Layer}" BorderBrush="{DynamicResource Brasa.Sep}"
                BorderThickness="0,1,0,0" Height="28">
            <Grid Margin="16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusLeft" Grid.Column="0" FontSize="11.5" FontFamily="{DynamicResource Brasa.Mono}"
                           Foreground="{DynamicResource Brasa.TextDim}" VerticalAlignment="Center" Text="就绪" />
                <TextBlock x:Name="StatusRight" Grid.Column="1" FontSize="11.5"
                           Foreground="{DynamicResource Brasa.TextDim}" VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
