<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Light counterpart to Theme/Dark.xaml: palette only, no styles and no fonts. Appearance.ApplyScheme appends
         this dictionary after Dark.xaml, and because WPF resolves merged dictionaries in reverse index order these
         keys win while Dark.xaml's implicit styles keep applying — their colour setters are all DynamicResource.
         Grey, not sand: the warm tint this board used to carry is what read as an amber cast, so the neutrals sit on
         R=G=B at the same lightness steps and only the accent tokens carry colour. The alpha nibbles from Dark.xaml
         are copied verbatim, only the tint direction flips (white wash becomes black wash). -->
    <Color x:Key="C.Bg">#FFE5E5E5</Color>
    <Color x:Key="C.Surface">#FFF8F8F8</Color>
    <Color x:Key="C.SurfaceAlt">#FFE8E8E8</Color>
    <Color x:Key="C.SurfaceHi">#FFE0E0E0</Color>
    <Color x:Key="C.Layer">#99F1F1F1</Color>
    <Color x:Key="C.LayerStrong">#EBEAEAEA</Color>
    <Color x:Key="C.Sep">#14000000</Color>
    <Color x:Key="C.Border">#26000000</Color>
    <Color x:Key="C.BorderHi">#4D000000</Color>
    <Color x:Key="C.Text">#FF282828</Color>
    <Color x:Key="C.TextDim">#FF5E5E5E</Color>
    <Color x:Key="C.Accent">#FF89541C</Color>
    <Color x:Key="C.AccentHi">#FF653E15</Color>
    <Color x:Key="C.AccentLo">#FF794A19</Color>
    <Color x:Key="C.OnAccent">#FFEEEEEE</Color>
    <Color x:Key="C.Good">#FF4F6B2E</Color>
    <Color x:Key="C.Bad">#FF95332A</Color>
    <Color x:Key="C.Warn">#FF8A5A12</Color>

    <!-- Surface / SurfaceAlt / SurfaceHi darken going up, the reverse of the dark board: all three are used as
         child-of-card or interaction fills, and WinUI light does the same job with black overlays. -->
    <SolidColorBrush x:Key="Brasa.Background" Color="{StaticResource C.Bg}" />
    <SolidColorBrush x:Key="Brasa.Surface" Color="{StaticResource C.Surface}" />
    <SolidColorBrush x:Key="Brasa.SurfaceAlt" Color="{StaticResource C.SurfaceAlt}" />
    <SolidColorBrush x:Key="Brasa.SurfaceHi" Color="{StaticResource C.SurfaceHi}" />
    <SolidColorBrush x:Key="Brasa.Layer" Color="{StaticResource C.Layer}" />
    <SolidColorBrush x:Key="Brasa.LayerStrong" Color="{StaticResource C.LayerStrong}" />
    <SolidColorBrush x:Key="Brasa.Sep" Color="{StaticResource C.Sep}" />
    <SolidColorBrush x:Key="Brasa.Border" Color="{StaticResource C.Border}" />
    <SolidColorBrush x:Key="Brasa.BorderHi" Color="{StaticResource C.BorderHi}" />
    <SolidColorBrush x:Key="Brasa.Text" Color="{StaticResource C.Text}" />
    <SolidColorBrush x:Key="Brasa.TextDim" Color="{StaticResource C.TextDim}" />
    <SolidColorBrush x:Key="Brasa.Accent" Color="{StaticResource C.Accent}" />
    <SolidColorBrush x:Key="Brasa.AccentHi" Color="{StaticResource C.AccentHi}" />
    <SolidColorBrush x:Key="Brasa.AccentLo" Color="{StaticResource C.AccentLo}" />
    <SolidColorBrush x:Key="Brasa.OnAccent" Color="{StaticResource C.OnAccent}" />
    <SolidColorBrush x:Key="Brasa.Good" Color="{StaticResource C.Good}" />
    <SolidColorBrush x:Key="Brasa.Bad" Color="{StaticResource C.Bad}" />
    <SolidColorBrush x:Key="Brasa.Warn" Color="{StaticResource C.Warn}" />
    <SolidColorBrush x:Key="Brasa.AccentGhost" Opacity="0.28" Color="{StaticResource C.Accent}" />

    <!-- Same six keys as Dark.xaml: ApplyMaterials looks them up by $"Brasa.Pane.{material}", so a missing one throws. -->
    <SolidColorBrush x:Key="Brasa.Pane.Mica" Color="#99F1F1F1" />
    <SolidColorBrush x:Key="Brasa.Pane.Acrylic" Color="#6EF1F1F1" />
    <SolidColorBrush x:Key="Brasa.Pane.Opaque" Color="#FFF1F1F1" />
    <SolidColorBrush x:Key="Brasa.Content.Mica" Color="#EBEAEAEA" />
    <SolidColorBrush x:Key="Brasa.Content.Acrylic" Color="#C2EAEAEA" />
    <SolidColorBrush x:Key="Brasa.Content.Opaque" Color="#FFEAEAEA" />
    <SolidColorBrush x:Key="Brasa.PaneBackground" Color="{StaticResource C.Layer}" />
    <SolidColorBrush x:Key="Brasa.ContentBackground" Color="{StaticResource C.LayerStrong}" />

    <!-- WPF-UI keys resolved through DynamicResource; retargeted here exactly as in Dark.xaml so the focused border,
         the drop-down pill and the nav selection follow the light board instead of the Windows system accent. -->
    <SolidColorBrush x:Key="TextControlFocusedBorderBrush" Color="{StaticResource C.AccentHi}" />
    <SolidColorBrush x:Key="ComboBoxBorderBrushFocused" Color="{StaticResource C.AccentHi}" />
    <SolidColorBrush x:Key="ComboBoxItemPillFillBrush" Color="{StaticResource C.Accent}" />
    <SolidColorBrush x:Key="ListBoxItemSelectedBackgroundThemeBrush" Color="{StaticResource C.Accent}" />
    <SolidColorBrush x:Key="NavigationViewSelectionIndicatorForeground" Color="Transparent" /><!-- NavPane draws the sliding bar itself -->
    <SolidColorBrush x:Key="NavigationViewItemBackgroundSelected" Color="{StaticResource C.SurfaceHi}" />
    <SolidColorBrush x:Key="NavigationViewItemBackgroundSelectedLeftFluent" Color="{StaticResource C.SurfaceHi}" />
    <SolidColorBrush x:Key="NavigationViewItemSeparatorForeground" Color="{StaticResource C.Sep}" />
    <SolidColorBrush x:Key="NavigationViewContentBackground" Color="{StaticResource C.LayerStrong}" />
    <SolidColorBrush x:Key="LeftNavigationViewSeparatorBrush" Color="{StaticResource C.Sep}" />

</ResourceDictionary>
