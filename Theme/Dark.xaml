<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Neutral tokens: Fluent layering (translucent white over a warm dark base) plus the SPT amber accent.
         WPF-UI pins its own accent to the Windows system colour: keys it resolves with StaticResource can only be
         replaced per control, but keys resolved with DynamicResource are retargeted below, since this dictionary
         merges last. -->
    <Color x:Key="C.Bg">#FF1A1A17</Color>
    <Color x:Key="C.Surface">#FF272724</Color>
    <Color x:Key="C.SurfaceAlt">#FF302F2B</Color>
    <Color x:Key="C.SurfaceHi">#FF333330</Color>
    <Color x:Key="C.Layer">#99242421</Color>
    <Color x:Key="C.LayerStrong">#EB201F1C</Color>
    <Color x:Key="C.Sep">#14FFFFFF</Color>
    <Color x:Key="C.Border">#26FFFFFF</Color>
    <Color x:Key="C.BorderHi">#4DFFFFFF</Color>
    <Color x:Key="C.Text">#FFDCD6C8</Color>
    <Color x:Key="C.TextDim">#FF968F80</Color>
    <Color x:Key="C.Accent">#FFE08A2E</Color>
    <Color x:Key="C.AccentHi">#FFF5A350</Color>
    <Color x:Key="C.AccentLo">#FFB96F1E</Color>
    <Color x:Key="C.OnAccent">#FF141412</Color>
    <Color x:Key="C.Good">#FF86A65A</Color>
    <Color x:Key="C.Bad">#FFC25A4A</Color>
    <Color x:Key="C.Warn">#FFD9A441</Color>

    <SolidColorBrush x:Key="Brasa.Background" Color="{StaticResource C.Bg}" />
    <SolidColorBrush x:Key="Brasa.Surface" Color="{StaticResource C.Surface}" />
    <SolidColorBrush x:Key="Brasa.SurfaceAlt" Color="{StaticResource C.SurfaceAlt}" />
    <SolidColorBrush x:Key="Brasa.SurfaceHi" Color="{StaticResource C.SurfaceHi}" />
    <SolidColorBrush x:Key="Brasa.Layer" Color="{StaticResource C.Layer}" />
    <SolidColorBrush x:Key="Brasa.LayerStrong" Color="{StaticResource C.LayerStrong}" />
    <SolidColorBrush x:Key="Brasa.Sep" Color="{StaticResource C.Sep}" />
    <SolidColorBrush x:Key="Brasa.Border" Color="{StaticResource C.Border}" />
    <SolidColorBrush x:Key="Brasa.BorderHi" Color="{StaticResource C.BorderHi}" />
    <SolidColorBrush x:Key="Brasa.Text" Color="{StaticResource C.Text}" />
    <SolidColorBrush x:Key="Brasa.TextDim" Color="{StaticResource C.TextDim}" />
    <SolidColorBrush x:Key="Brasa.Accent" Color="{StaticResource C.Accent}" />
    <SolidColorBrush x:Key="Brasa.AccentHi" Color="{StaticResource C.AccentHi}" />
    <SolidColorBrush x:Key="Brasa.AccentLo" Color="{StaticResource C.AccentLo}" />
    <SolidColorBrush x:Key="Brasa.OnAccent" Color="{StaticResource C.OnAccent}" />
    <SolidColorBrush x:Key="Brasa.Good" Color="{StaticResource C.Good}" />
    <SolidColorBrush x:Key="Brasa.Bad" Color="{StaticResource C.Bad}" />
    <SolidColorBrush x:Key="Brasa.Warn" Color="{StaticResource C.Warn}" />
    <SolidColorBrush x:Key="Brasa.AccentGhost" Opacity="0.16" Color="{StaticResource C.Accent}" />

    <!-- Per-region backdrops. The two keys the chrome actually binds to are swapped at runtime between the
         material brushes below; their defaults equal C.Layer / C.LayerStrong so nothing changes on first launch.
         Mica keeps the current strengths (the pane needs to stay translucent to read as mica, the content area
         needs to stay near-opaque to hold form fields); acrylic thins the tint so the DWM blur shows through. -->
    <SolidColorBrush x:Key="Brasa.Pane.Mica" Color="#99242421" />
    <SolidColorBrush x:Key="Brasa.Pane.Acrylic" Color="#6E242421" />
    <SolidColorBrush x:Key="Brasa.Pane.Opaque" Color="#FF242421" />
    <SolidColorBrush x:Key="Brasa.Content.Mica" Color="#EB201F1C" />
    <SolidColorBrush x:Key="Brasa.Content.Acrylic" Color="#C2201F1C" />
    <SolidColorBrush x:Key="Brasa.Content.Opaque" Color="#FF201F1C" />
    <SolidColorBrush x:Key="Brasa.PaneBackground" Color="{StaticResource C.Layer}" />
    <SolidColorBrush x:Key="Brasa.ContentBackground" Color="{StaticResource C.LayerStrong}" />

    <!-- Keys WPF-UI resolves through DynamicResource: retargeting them here keeps the focused border, the
         drop-down pill and the picker selection amber instead of the Windows system accent. -->
    <SolidColorBrush x:Key="TextControlFocusedBorderBrush" Color="{StaticResource C.AccentHi}" />
    <SolidColorBrush x:Key="ComboBoxBorderBrushFocused" Color="{StaticResource C.AccentHi}" />
    <SolidColorBrush x:Key="ComboBoxItemPillFillBrush" Color="{StaticResource C.Accent}" />
    <SolidColorBrush x:Key="ListBoxItemSelectedBackgroundThemeBrush" Color="{StaticResource C.Accent}" />
    <SolidColorBrush x:Key="NavigationViewSelectionIndicatorForeground" Color="{StaticResource C.Accent}" />
    <SolidColorBrush x:Key="NavigationViewItemBackgroundSelected" Color="{StaticResource C.SurfaceHi}" />
    <SolidColorBrush x:Key="NavigationViewItemBackgroundSelectedLeftFluent" Color="{StaticResource C.SurfaceHi}" />
    <SolidColorBrush x:Key="NavigationViewItemSeparatorForeground" Color="{StaticResource C.Sep}" />
    <SolidColorBrush x:Key="NavigationViewContentBackground" Color="{StaticResource C.LayerStrong}" />
    <SolidColorBrush x:Key="LeftNavigationViewSeparatorBrush" Color="{StaticResource C.Sep}" />

    <FontFamily x:Key="Brasa.Font">Microsoft YaHei UI, Segoe UI</FontFamily>
    <FontFamily x:Key="Brasa.Mono">Cascadia Mono, Consolas</FontFamily>
    <sys:Double x:Key="ContentControlFontSize">13</sys:Double>

    <!-- WPF-UI has no implicit style for these two, and Chinese body text needs YaHei over Segoe UI Variable.
         No Foreground here on purpose: a style setter outranks the inherited value WPF-UI's templates push down. -->
    <Style TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="{DynamicResource Brasa.Font}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
    </Style>

    <Style TargetType="{x:Type Label}">
        <Setter Property="FontFamily" Value="{DynamicResource Brasa.Font}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <!-- Amber call-to-action. WPF-UI sets its Appearance colours from control-template triggers,
         so these have to be style triggers to outrank them. -->
    <Style x:Key="Brasa.Button.Primary" TargetType="{x:Type ui:Button}" BasedOn="{StaticResource DefaultUiButtonStyle}">
        <Setter Property="Appearance" Value="Primary" />
        <Style.Triggers>
            <Trigger Property="Appearance" Value="Primary">
                <Setter Property="Background" Value="{DynamicResource Brasa.Accent}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Brasa.AccentLo}" />
                <Setter Property="Foreground" Value="{DynamicResource Brasa.OnAccent}" />
                <Setter Property="MouseOverBackground" Value="{DynamicResource Brasa.AccentHi}" />
                <Setter Property="MouseOverBorderBrush" Value="{DynamicResource Brasa.AccentHi}" />
                <Setter Property="PressedBackground" Value="{DynamicResource Brasa.AccentLo}" />
                <Setter Property="PressedForeground" Value="{DynamicResource Brasa.OnAccent}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource Brasa.TextDim}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Page switcher pills (Ui.Segmented). The Tag trigger is declared last so a selected pill keeps its
         amber ghost when the cursor passes over it instead of flickering to the plain hover colour. -->
    <Style x:Key="Brasa.Segment" TargetType="{x:Type Button}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Brasa.Text}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="14,5,14,5" />
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="bd" CornerRadius="4" Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource Brasa.SurfaceHi}" />
                        </Trigger>
                        <Trigger Property="Tag" Value="on">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource Brasa.AccentGhost}" />
                            <Setter Property="Foreground" Value="{DynamicResource Brasa.AccentHi}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Boolean fields: the pill stays ours so it lines up with the 中文标签 + 原始键 row height. -->
    <Style x:Key="Brasa.Switch" TargetType="{x:Type CheckBox}">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type CheckBox}">
                    <Border x:Name="track" Width="40" Height="20" CornerRadius="10"
                            Background="{DynamicResource ControlFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1">
                        <Ellipse x:Name="knob" Width="12" Height="12" Fill="{DynamicResource TextFillColorSecondaryBrush}"
                                 HorizontalAlignment="Left" Margin="4,0,0,0" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="track" Property="Background" Value="{DynamicResource Brasa.Accent}" />
                            <Setter TargetName="track" Property="BorderBrush" Value="{DynamicResource Brasa.Accent}" />
                            <Setter TargetName="knob" Property="Fill" Value="{DynamicResource Brasa.OnAccent}" />
                            <Setter TargetName="knob" Property="HorizontalAlignment" Value="Right" />
                            <Setter TargetName="knob" Property="Margin" Value="0,0,4,0" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="track" Property="BorderBrush" Value="{DynamicResource Brasa.AccentHi}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- WPF-UI binds its Slider accent to the Windows system colour, so this one stays ours to keep the amber. -->
    <Style TargetType="{x:Type Slider}">
        <Setter Property="MinHeight" Value="20" />
        <Setter Property="IsMoveToPointEnabled" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Slider}">
                    <Grid VerticalAlignment="Center">
                        <Border Height="4" CornerRadius="2" VerticalAlignment="Center"
                                Background="{DynamicResource Brasa.SurfaceHi}" />
                        <Track x:Name="PART_Track">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="Slider.DecreaseLarge" Focusable="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="{x:Type RepeatButton}">
                                            <Border Height="4" CornerRadius="2" Background="{DynamicResource Brasa.Accent}" />
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="Slider.IncreaseLarge" Focusable="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="{x:Type RepeatButton}">
                                            <Border Height="4" Background="Transparent" />
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Width="14" Height="14" Cursor="Hand">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="{x:Type Thumb}">
                                            <Ellipse Fill="{DynamicResource Brasa.AccentHi}"
                                                     Stroke="{DynamicResource Brasa.Background}" StrokeThickness="2" />
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Selection colour is a brush on the control, not a SystemColors lookup, so it has to be set per text type.
         WPF-UI sizes a field for ~37px (padding 10,8,10,7 over 14px text); our rows are denser, so trim the padding
         and let MinHeight carry the line box, since the template binds Height/MinHeight onto the inner Border. -->
    <Style TargetType="{x:Type TextBox}" BasedOn="{StaticResource DefaultTextBoxStyle}">
        <Setter Property="Padding" Value="10,4,10,4" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="SelectionBrush" Value="{DynamicResource Brasa.Accent}" />
        <Setter Property="SelectionTextBrush" Value="{DynamicResource Brasa.OnAccent}" />
    </Style>

    <Style TargetType="{x:Type ui:TextBox}" BasedOn="{StaticResource DefaultUiTextBoxStyle}">
        <Setter Property="Padding" Value="10,4,10,4" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="SelectionBrush" Value="{DynamicResource Brasa.Accent}" />
        <Setter Property="SelectionTextBrush" Value="{DynamicResource Brasa.OnAccent}" />
    </Style>

    <Style x:Key="Brasa.JsonBox" TargetType="{x:Type TextBox}" BasedOn="{StaticResource {x:Type TextBox}}">
        <Setter Property="FontFamily" Value="{DynamicResource Brasa.Mono}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Padding" Value="10,8,10,8" />
        <Setter Property="VerticalContentAlignment" Value="Top" />
        <Setter Property="AcceptsReturn" Value="True" />
        <Setter Property="AcceptsTab" Value="True" />
        <Setter Property="TextWrapping" Value="NoWrap" />
        <Setter Property="HorizontalScrollBarVisibility" Value="Auto" />
        <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="Background" Value="{DynamicResource Brasa.Background}" />
    </Style>

</ResourceDictionary>
