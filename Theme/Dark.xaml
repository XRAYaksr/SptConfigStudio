<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- ================= palette: Escape from Tarkov / SPT ================= -->
    <Color x:Key="C.Bg">#FF131311</Color>
    <Color x:Key="C.Surface">#FF1B1B18</Color>
    <Color x:Key="C.SurfaceAlt">#FF232320</Color>
    <Color x:Key="C.SurfaceHi">#FF2C2C27</Color>
    <Color x:Key="C.Border">#FF3C3B34</Color>
    <Color x:Key="C.BorderHi">#FF55534A</Color>
    <Color x:Key="C.Text">#FFDCD6C8</Color>
    <Color x:Key="C.TextDim">#FF8F897B</Color>
    <Color x:Key="C.Accent">#FFE08A2E</Color>
    <Color x:Key="C.AccentHi">#FFF5A350</Color>
    <Color x:Key="C.Good">#FF86A65A</Color>
    <Color x:Key="C.Bad">#FFC25A4A</Color>
    <Color x:Key="C.Warn">#FFD9A441</Color>

    <SolidColorBrush x:Key="Brasa.Background" Color="{StaticResource C.Bg}" />
    <SolidColorBrush x:Key="Brasa.Surface" Color="{StaticResource C.Surface}" />
    <SolidColorBrush x:Key="Brasa.SurfaceAlt" Color="{StaticResource C.SurfaceAlt}" />
    <SolidColorBrush x:Key="Brasa.SurfaceHi" Color="{StaticResource C.SurfaceHi}" />
    <SolidColorBrush x:Key="Brasa.Border" Color="{StaticResource C.Border}" />
    <SolidColorBrush x:Key="Brasa.BorderHi" Color="{StaticResource C.BorderHi}" />
    <SolidColorBrush x:Key="Brasa.Text" Color="{StaticResource C.Text}" />
    <SolidColorBrush x:Key="Brasa.TextDim" Color="{StaticResource C.TextDim}" />
    <SolidColorBrush x:Key="Brasa.Accent" Color="{StaticResource C.Accent}" />
    <SolidColorBrush x:Key="Brasa.AccentHi" Color="{StaticResource C.AccentHi}" />
    <SolidColorBrush x:Key="Brasa.Good" Color="{StaticResource C.Good}" />
    <SolidColorBrush x:Key="Brasa.Bad" Color="{StaticResource C.Bad}" />
    <SolidColorBrush x:Key="Brasa.Warn" Color="{StaticResource C.Warn}" />
    <SolidColorBrush x:Key="Brasa.AccentGhost" Opacity="0.16" Color="{StaticResource C.Accent}" />

    <FontFamily x:Key="Brasa.Font">Microsoft YaHei UI, Segoe UI</FontFamily>
    <FontFamily x:Key="Brasa.Mono">Cascadia Mono, Consolas</FontFamily>
    <sys:Double x:Key="Brasa.Radius">4</sys:Double>

    <!-- ================= defaults ================= -->
    <Style TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="{DynamicResource Brasa.Text}" />
        <Setter Property="FontFamily" Value="{DynamicResource Brasa.Font}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
    </Style>

    <Style TargetType="{x:Type Label}">
        <Setter Property="Foreground" Value="{DynamicResource Brasa.Text}" />
        <Setter Property="FontFamily" Value="{DynamicResource Brasa.Font}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <!-- ================= scrollbars ================= -->
    <Style x:Key="Brasa.ScrollThumb" TargetType="{x:Type Thumb}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Thumb}">
                    <Border Background="{DynamicResource Brasa.BorderHi}" CornerRadius="3" Margin="3,1" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type ScrollBar}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Width" Value="10" />
        <Setter Property="MinWidth" Value="10" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ScrollBar}">
                    <Grid Background="{TemplateBinding Background}">
                        <Track x:Name="PART_Track" IsDirectionReversed="true">
                            <Track.Thumb>
                                <Thumb Style="{StaticResource Brasa.ScrollThumb}" />
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False" />
                            </Track.IncreaseRepeatButton>
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False" />
                            </Track.DecreaseRepeatButton>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Orientation" Value="Horizontal">
                            <Setter Property="Width" Value="Auto" />
                            <Setter Property="Height" Value="10" />
                            <Setter Property="MinHeight" Value="10" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type ScrollViewer}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ScrollViewer}">
                    <Grid Background="{TemplateBinding Background}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <ScrollContentPresenter Grid.Row="0" Grid.Column="0"
                                                Margin="{TemplateBinding Padding}"
                                                CanContentScroll="{TemplateBinding CanContentScroll}" />
                        <ScrollBar x:Name="PART_VerticalScrollBar" Grid.Row="0" Grid.Column="1"
                                   Orientation="Vertical" Maximum="{TemplateBinding ScrollableHeight}"
                                   ViewportSize="{TemplateBinding ViewportHeight}"
                                   Value="{TemplateBinding VerticalOffset}"
                                   Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"
                                   Cursor="Arrow" />
                        <ScrollBar x:Name="PART_HorizontalScrollBar" Grid.Row="1" Grid.Column="0"
                                   Orientation="Horizontal" Maximum="{TemplateBinding ScrollableWidth}"
                                   ViewportSize="{TemplateBinding ViewportWidth}"
                                   Value="{TemplateBinding HorizontalOffset}"
                                   Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}"
                                   Cursor="Arrow" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================= buttons ================= -->
    <Style TargetType="{x:Type Button}">
        <Setter Property="Foreground" Value="{DynamicResource Brasa.Text}" />
        <Setter Property="Background" Value="{DynamicResource Brasa.SurfaceHi}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brasa.Border}" />
        <Setter Property="FontFamily" Value="{DynamicResource Brasa.Font}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="bd" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Brasa.Accent}" />
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource Brasa.SurfaceAlt}" />
                            <Setter Property="Foreground" Value="{DynamicResource Brasa.AccentHi}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource Brasa.AccentGhost}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.38" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Brasa.Button.Primary" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{DynamicResource Brasa.Accent}" />
        <Setter Property="Foreground" Value="#FF141412" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brasa.Accent}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="bd" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                            CornerRadius="4" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource Brasa.AccentHi}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="#FFB96F1E" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.38" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Brasa.NavItem" TargetType="{x:Type RadioButton}">
        <Setter Property="Foreground" Value="{DynamicResource Brasa.Text}" />
        <Setter Property="FontFamily" Value="{DynamicResource Brasa.Font}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type RadioButton}">
                    <Border x:Name="bd" Background="Transparent" CornerRadius="3" Padding="10,6" Margin="6,1">
                        <Grid>
                            <Rectangle x:Name="bar" Width="3" RadiusX="1.5" RadiusY="1.5" Fill="Transparent"
                                       HorizontalAlignment="Left" />
                            <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource Brasa.SurfaceAlt}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource Brasa.SurfaceHi}" />
                            <Setter TargetName="bar" Property="Fill" Value="{DynamicResource Brasa.Accent}" />
                            <Setter Property="Foreground" Value="{DynamicResource Brasa.AccentHi}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================= inputs ================= -->
    <Style TargetType="{x:Type TextBox}">
        <Setter Property="Foreground" Value="{DynamicResource Brasa.Text}" />
        <Setter Property="CaretBrush" Value="{DynamicResource Brasa.Accent}" />
        <Setter Property="Background" Value="{DynamicResource Brasa.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brasa.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontFamily" Value="{DynamicResource Brasa.Font}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="7,3" />
        <Setter Property="SelectionBrush" Value="{DynamicResource Brasa.Accent}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TextBox}">
                    <Border x:Name="bd" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                      VerticalScrollBarVisibility="Hidden" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Brasa.BorderHi}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Brasa.Accent}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Brasa.JsonBox" TargetType="{x:Type TextBox}" BasedOn="{StaticResource {x:Type TextBox}}">
        <Setter Property="FontFamily" Value="{DynamicResource Brasa.Mono}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="AcceptsReturn" Value="True" />
        <Setter Property="AcceptsTab" Value="True" />
        <Setter Property="TextWrapping" Value="NoWrap" />
        <Setter Property="HorizontalScrollBarVisibility" Value="Auto" />
        <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="Background" Value="{DynamicResource Brasa.Background}" />
    </Style>

    <Style TargetType="{x:Type CheckBox}">
        <Setter Property="Foreground" Value="{DynamicResource Brasa.Text}" />
        <Setter Property="FontFamily" Value="{DynamicResource Brasa.Font}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type CheckBox}">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Border x:Name="box" Width="16" Height="16" CornerRadius="3" VerticalAlignment="Center"
                                Background="{DynamicResource Brasa.Surface}" BorderBrush="{DynamicResource Brasa.BorderHi}"
                                BorderThickness="1">
                            <Path x:Name="tick" Data="M 2,7 L 6,11 L 13,2" Stroke="{DynamicResource Brasa.Accent}"
                                  StrokeThickness="2" StrokeEndLineCap="Round" StrokeStartLineCap="Round"
                                  Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center" />
                        </Border>
                        <ContentPresenter Margin="7,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="tick" Property="Visibility" Value="Visible" />
                            <Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource Brasa.Accent}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="box" Property="Background" Value="{DynamicResource Brasa.SurfaceAlt}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- pill toggle switch -->
    <Style x:Key="Brasa.Switch" TargetType="{x:Type CheckBox}">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type CheckBox}">
                    <Border x:Name="track" Width="36" Height="19" CornerRadius="9.5"
                            Background="{DynamicResource Brasa.SurfaceAlt}"
                            BorderBrush="{DynamicResource Brasa.BorderHi}" BorderThickness="1">
                        <Ellipse x:Name="knob" Width="13" Height="13" Fill="{DynamicResource Brasa.TextDim}"
                                 HorizontalAlignment="Left" Margin="3,0,0,0" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="track" Property="Background" Value="{DynamicResource Brasa.AccentGhost}" />
                            <Setter TargetName="track" Property="BorderBrush" Value="{DynamicResource Brasa.Accent}" />
                            <Setter TargetName="knob" Property="Fill" Value="{DynamicResource Brasa.Accent}" />
                            <Setter TargetName="knob" Property="HorizontalAlignment" Value="Right" />
                            <Setter TargetName="knob" Property="Margin" Value="0,0,3,0" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="track" Property="BorderBrush" Value="{DynamicResource Brasa.AccentHi}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type ComboBox}">
        <Setter Property="Foreground" Value="{DynamicResource Brasa.Text}" />
        <Setter Property="Background" Value="{DynamicResource Brasa.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brasa.Border}" />
        <Setter Property="FontFamily" Value="{DynamicResource Brasa.Font}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="7,3" />
        <Setter Property="Height" Value="26" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ComboBox}">
                    <Grid>
                        <ToggleButton x:Name="tb" Focusable="False" ClickMode="Press"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                      Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="{x:Type ToggleButton}">
                                    <Border x:Name="bd" Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="3">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="20" />
                                            </Grid.ColumnDefinitions>
                                            <Path Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  Data="M 0 0 L 4 4 L 8 0 Z" Fill="{DynamicResource Brasa.TextDim}" />
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Brasa.Accent}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <ContentPresenter x:Name="cp" Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          Margin="8,0,28,0" VerticalAlignment="Center" IsHitTestVisible="False" />
                        <Popup x:Name="pop" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}"
                               AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                            <Border Background="{DynamicResource Brasa.SurfaceAlt}" BorderBrush="{DynamicResource Brasa.BorderHi}"
                                    BorderThickness="1" CornerRadius="3" MinWidth="{TemplateBinding ActualWidth}"
                                    MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                <ScrollViewer>
                                    <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type ComboBoxItem}">
        <Setter Property="Foreground" Value="{DynamicResource Brasa.Text}" />
        <Setter Property="FontFamily" Value="{DynamicResource Brasa.Font}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="8,5" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ComboBoxItem}">
                    <Border x:Name="bd" Background="Transparent" Padding="{TemplateBinding Padding}" CornerRadius="2" Margin="2,0">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource Brasa.AccentGhost}" />
                            <Setter Property="Foreground" Value="{DynamicResource Brasa.AccentHi}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type Slider}">
        <Setter Property="Foreground" Value="{DynamicResource Brasa.Accent}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Slider}">
                    <Grid VerticalAlignment="Center" MinHeight="20">
                        <Border Height="4" CornerRadius="2" VerticalAlignment="Center"
                                Background="{DynamicResource Brasa.SurfaceHi}" />
                        <Border Height="4" CornerRadius="2" VerticalAlignment="Center" HorizontalAlignment="Left"
                                Width="{Binding Width, RelativeSource={RelativeSource Self}}"
                                Background="{DynamicResource Brasa.Accent}" x:Name="partial" />
                        <Track x:Name="PART_Track">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="Slider.DecreaseLarge" Opacity="0" Focusable="False" />
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="Slider.IncreaseLarge" Opacity="0" Focusable="False" />
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Width="13" Height="13">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="{x:Type Thumb}">
                                            <Ellipse Fill="{DynamicResource Brasa.AccentHi}" Stroke="#FF141412" StrokeThickness="2" />
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type ToolTip}">
        <Setter Property="Background" Value="#FF2A2A25" />
        <Setter Property="Foreground" Value="{DynamicResource Brasa.Text}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brasa.BorderHi}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="9,6" />
        <Setter Property="MaxWidth" Value="380" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ToolTip}">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4"
                            Padding="{TemplateBinding Padding}">
                        <TextBlock Text="{TemplateBinding Content}" TextWrapping="Wrap" FontSize="12"
                                   FontFamily="{DynamicResource Brasa.Font}"
                                   Foreground="{DynamicResource Brasa.Text}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type ListBox}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource Brasa.Text}" />
    </Style>

    <Style TargetType="{x:Type ListBoxItem}">
        <Setter Property="Foreground" Value="{DynamicResource Brasa.Text}" />
        <Setter Property="FontFamily" Value="{DynamicResource Brasa.Font}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="9,5" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ListBoxItem}">
                    <Border x:Name="bd" Background="Transparent" CornerRadius="3" Padding="{TemplateBinding Padding}" Margin="2,1">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource Brasa.SurfaceAlt}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource Brasa.AccentGhost}" />
                            <Setter Property="Foreground" Value="{DynamicResource Brasa.AccentHi}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type TabControl}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TabControl}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Orientation="Horizontal" IsItemsHost="True" Margin="4,0,4,8" />
                        <ContentPresenter Grid.Row="1" ContentSource="SelectedContent" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type TabItem}">
        <Setter Property="Foreground" Value="{DynamicResource Brasa.TextDim}" />
        <Setter Property="FontFamily" Value="{DynamicResource Brasa.Font}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TabItem}">
                    <Border x:Name="bd" Background="Transparent" BorderBrush="Transparent" BorderThickness="0,0,0,2"
                            Padding="14,7" Margin="0,0,2,0">
                        <ContentPresenter ContentSource="Header" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource Brasa.Text}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource Brasa.AccentHi}" />
                            <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Brasa.Accent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================= shared building blocks ================= -->
    <Style x:Key="Brasa.Card" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{DynamicResource Brasa.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brasa.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="5" />
        <Setter Property="Padding" Value="14" />
    </Style>

    <Style x:Key="Brasa.SectionTitle" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Brasa.AccentHi}" />
    </Style>

    <Style x:Key="Brasa.Hint" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="Foreground" Value="{DynamicResource Brasa.TextDim}" />
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="Brasa.FieldLabel" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="Brasa.MonoChip" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{DynamicResource Brasa.SurfaceHi}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brasa.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="3" />
        <Setter Property="Padding" Value="6,2" />
    </Style>

</ResourceDictionary>
